{
  "productName": "Lens",
  "version": "0.1.0",
  "identifier": "com.lens.proxy",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:7317",
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Lens · AI 编程代理透镜",
        "width": 1400,
        "height": 850,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "copyright": "© 2026 badhope",
    "category": "DeveloperTool",
    "shortDescription": "AI 编程代理透镜",
    "longDescription": "Lens — 拦截并可视化 AI 编程代理与 LLM 通信的本地代理工具",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
